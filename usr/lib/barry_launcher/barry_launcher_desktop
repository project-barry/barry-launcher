#!/bin/bash
# barry_launcher_desktop: Barry Launcher's trackpad and keyboard for the AYN
# Thor's top screen, on the bottom screen in Desktop Mode (Desktop.qml).
# Portable version: pb-os's Desktop Mode (Barry's home, apps and keyboard as
# KWin's input method) is set up for PB-OS on the Thor only; elsewhere this
# stays the trackpad and keyboard window.
# X11, where a window can refuse keyboard focus; the pointer and keys come
# from barry_launcher_inputd, started here if it is not running yet.
systemctl --user start barry_launcher_inputd.service
# Portable version: with Barry Launcher's settings, which give Desktop.qml
# the bottom panel's connector and size.
[[ -n "${BARRY_LIB:-}" ]] || exec /usr/lib/barry_launcher/barry_launcher_env "$0" "$@"
export QT_QPA_PLATFORM=xcb
exec qml6 /usr/share/barry_launcher/shell/Desktop.qml \
  -- "$BARRY_BOTTOM_CONNECTOR" "$BARRY_BOTTOM_WIDTH" "$BARRY_BOTTOM_HEIGHT"
