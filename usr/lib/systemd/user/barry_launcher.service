[Unit]
Description=Barry Launcher: AYN Thor bottom-screen home, apps and dashboard
PartOf=@SESSION_UNIT@
After=@SESSION_UNIT@

[Service]
Type=simple
# Portable version: install.sh fills in @SESSION_UNIT@ and the paths; the
# device check, lease socket and orientation come from barry_launcher_env.
ExecCondition=/usr/lib/barry_launcher/barry_launcher_env --check
# Game Mode's gamescope creates the lease socket once it is up.
ExecStartPre=/usr/lib/barry_launcher/barry_launcher_env --wait-lease 60
ExecStart=/usr/lib/barry_launcher/barry_launcher_env /usr/lib/barry_launcher/barry_launcher_run_bottom -- /usr/lib/barry_launcher/barry_launcher_session
Restart=on-failure
RestartSec=3
# The nested gamescope can ignore SIGTERM; don't hold up a Game Mode restart
# (default 90 s) for it.
TimeoutStopSec=5

[Install]
WantedBy=@SESSION_UNIT@
